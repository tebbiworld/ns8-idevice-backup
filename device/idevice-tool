# Backup helper run inside the engine container by the module (podman exec).
# It connects to an iOS device by explicit IP over the classic lockdown TCP
# port (62078) using an uploaded pairing record, and drives mobilebackup2.
# No usbmux, no netmuxd, no mDNS. Output is a single JSON line on stdout.
#
# Subcommands:
#   ping   --udid U --ip A            connectivity + device info
#   backup --udid U --ip A --dir D    full backup into D; set encryption from
#                                      $IDEVICE_SET_PASSWORD when --set-password
#
# API verified against pymobiledevice3 11.14.0:
#   create_using_tcp(hostname, autopair=False, pair_record=<dict>, port=62078)
#   Mobilebackup2Service(lockdown) -> async ctx; .backup(full, backup_directory)
#   .change_password(backup_directory, old, new)  (enables device encryption)

import argparse
import asyncio
import json
import os
import plistlib
import sys

LOCKDOWN_DIR = "/var/lib/lockdown"


def load_pair_record(udid):
    with open(os.path.join(LOCKDOWN_DIR, f"{udid}.plist"), "rb") as fp:
        return plistlib.load(fp)


async def connect(udid, ip):
    from pymobiledevice3.lockdown import create_using_tcp
    record = load_pair_record(udid)
    return await create_using_tcp(hostname=ip, autopair=False, pair_record=record)


async def cmd_ping(args):
    ld = await connect(args.udid, args.ip)
    info = {"ok": True, "udid": args.udid}
    try:
        info["product_version"] = getattr(ld, "product_version", "") or ""
    except Exception:
        info["product_version"] = ""
    try:
        info["device_name"] = ld.get_value(key="DeviceName")
    except Exception:
        info["device_name"] = getattr(ld, "display_name", "") or ""
    print(json.dumps(info))


async def cmd_backup(args):
    from pymobiledevice3.services.mobilebackup2 import Mobilebackup2Service
    ld = await connect(args.udid, args.ip)
    os.makedirs(args.dir, exist_ok=True)
    enabled_encryption = False
    async with Mobilebackup2Service(ld) as svc:
        if args.set_password:
            pw = os.environ.get("IDEVICE_SET_PASSWORD", "")
            if pw:
                # old='' turns encryption ON with the new password (device-side)
                await svc.change_password(backup_directory=args.dir, old="", new=pw)
                enabled_encryption = True
        await svc.backup(full=True, backup_directory=args.dir)
    print(json.dumps({"ok": True, "dir": args.dir, "encryption_enabled": enabled_encryption}))


def main():
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("ping")
    p.add_argument("--udid", required=True)
    p.add_argument("--ip", required=True)
    b = sub.add_parser("backup")
    b.add_argument("--udid", required=True)
    b.add_argument("--ip", required=True)
    b.add_argument("--dir", required=True)
    b.add_argument("--set-password", action="store_true")
    args = ap.parse_args()
    try:
        asyncio.run(cmd_ping(args) if args.cmd == "ping" else cmd_backup(args))
    except Exception as e:
        print(json.dumps({"ok": False, "error": str(e)[:2000], "type": type(e).__name__}))
        sys.exit(1)


if __name__ == "__main__":
    main()
