# Regenerate <AGENT_INSTALL_DIR>/etc/state-include.conf from IDEVICE_INCLUDE_BACKUPS.
# The backup framework reads this file both to pick restic include paths AND to
# decide which volumes to mount into the backup — so the volumes/idevice-data
# line is what actually adds (or omits) the device backups. Called by
# configure-module and by the update hook (the image re-extraction resets it).
import os

BASE = [
    "#",
    "# Generated from IDEVICE_INCLUDE_BACKUPS by the module. Do not edit by hand.",
    "# Always carried: the pairing records, the device registry and the device",
    "# passwords (small, critical).",
    "#",
    "state/environment",
    "state/passwords.env",
    "state/devices.json",
    "state/device-secrets.json",
    "volumes/idevice-lockdown",
]

def main():
    include = (os.environ.get("IDEVICE_INCLUDE_BACKUPS", "false").strip().lower()
               in ("1", "true", "yes", "on"))
    lines = list(BASE)
    if include:
        lines += [
            "# IDEVICE_INCLUDE_BACKUPS=true: the (large) device backups are in the NS8 backup too.",
            "volumes/idevice-data",
        ]
    path = os.path.join(os.environ["AGENT_INSTALL_DIR"], "etc", "state-include.conf")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fp:
        fp.write("\n".join(lines) + "\n")
    os.replace(tmp, path)

if __name__ == "__main__":
    main()
