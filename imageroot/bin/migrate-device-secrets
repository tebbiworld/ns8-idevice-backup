# Up to 1.3.0 the backup encryption password of a device was a field of
# state/devices.json, a file with mode 0644. Move the passwords to
# state/device-secrets.json and set both files to 0600. The values do not
# change, running it again changes nothing. Called by the update hook, after a
# restore or clone (the state may come from an older version) and before the
# services start.

import sys

import devreg

moved = devreg.migrate()
if moved:
    print(f"moved the backup password of {moved} device(s) to state/device-secrets.json", file=sys.stderr)
