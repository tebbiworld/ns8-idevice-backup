# ExecStartPre of idevice-web (through runagent): write state/ldap.env with the
# directory connection (see pypkg/ldapsettings.py): for a user domain the
# node's ldapproxy and its bind account, read on every start so a changed
# bind password is picked up by a restart (events/user-domain-changed); for an
# LDAP server of its own the stored settings. The file carries the bind
# password: mode 0600, regenerated, not part of the backup.

import os

import ldapsettings

ldapsettings.write_env_file("ldap.env", active=os.environ.get("LDAP_ENABLED", "false") == "true")
