#
# The image re-extraction resets etc/state-include.conf to the packaged default,
# so re-apply the IDEVICE_INCLUDE_BACKUPS choice, then restart both units onto
# the new image (the engine and, if it is configured, the self-service web app).
set -e
exec 1>&2
regen-state-include || true
systemctl --user daemon-reload
systemctl --user restart idevice-backup.service
# Restart the web app too, but only when it is enabled (a self-service host set).
if systemctl --user is-enabled idevice-web.service >/dev/null 2>&1; then
    systemctl --user restart idevice-web.service || true
fi
