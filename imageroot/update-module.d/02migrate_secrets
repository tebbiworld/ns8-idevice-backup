# Up to 1.2.3 the session secret and the LDAP bind password were stored with
# agent.mset_env(), i.e. in state/environment, which the agent mirrors to Redis
# in plain text. Move them to state/passwords.env (0600); the values do not
# change. This hook runs before 03allocate_web_port on purpose: that one may
# re-apply the configuration, which writes web.env from passwords.env; with the
# secret still in the environment the portal got an empty session secret.

import os
import secrets

import modsecrets

modsecrets.migrate_from_env(["SESSION_SECRET", "LDAP_BIND_PASSWORD"])
# instances created before the self-service portal existed have no secret yet
modsecrets.ensure({"SESSION_SECRET": secrets.token_hex(32)})

# these generated files carry the secrets as well
state = os.environ["AGENT_STATE_DIR"]
for name in ("ldap.env", "web.env"):
    path = os.path.join(state, name)
    if os.path.exists(path):
        os.chmod(path, 0o600)
