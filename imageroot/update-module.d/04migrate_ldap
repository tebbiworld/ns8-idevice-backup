# Before the shared directory login (ldapsettings) the portal only knew an
# LDAP server entered by hand, without certificate check unless a CA file was
# given. Keep exactly that behaviour: source "custom", certificate check off,
# Active Directory filters. The admin can switch to a user domain of the
# cluster (recommended) in the settings.

import os

import agent

if not os.environ.get("LDAP_SOURCE"):
    url = os.environ.get("LDAP_URL", "")
    agent.set_env("LDAP_SOURCE", "custom" if url else "domain")
    if url:
        agent.set_env("LDAP_TLS_VERIFY", "false")
        agent.set_env("LDAP_START_TLS", "false")
        agent.set_env("LDAP_SCHEMA", "ad")
    # replaced by bin/discover-ldap (host network, no container address)
    for key in ("LDAP_HOST", "LDAP_PORT"):
        if key in os.environ:
            agent.unset_env(key)

# the portal now runs in the host network: the unit sets its listen address
# and port, an old web.env must not keep the former container port 8080
try:
    with open("web.env") as fp:
        lines = fp.readlines()
    kept = [line for line in lines if not line.startswith(("WEB_INTERNAL_PORT=", "WEB_HOST="))]
    if kept != lines:
        old_umask = os.umask(0o077)
        with open("web.env.tmp", "w") as fp:
            fp.writelines(kept)
        os.replace("web.env.tmp", "web.env")
        os.umask(old_umask)
except FileNotFoundError:
    pass
