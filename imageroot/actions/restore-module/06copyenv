# Carry the global options of the backed-up instance over to the new one. The
# device registry (state/devices.json) and the pairing records
# (volumes/idevice-lockdown) are restored by restic from state-include.conf.

import json
import sys

import agent

request = json.load(sys.stdin)
env = request["environment"]
keep = ["RETENTION"]
agent.mset_env({k: env[k] for k in keep if k in env})
