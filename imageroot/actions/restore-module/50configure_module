# Re-apply the options and start the engine on the restored volumes (pairing
# records and device backups).

import os

import agent
import agent.tasks

env = os.environ
data = {"retention": int(env.get("RETENTION", "3"))}
response = agent.tasks.run(agent_id=env["AGENT_ID"], action="configure-module", data=data)
agent.assert_exp(response["exit_code"] == 0, "The configure-module subtask failed!")
