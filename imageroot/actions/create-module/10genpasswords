# Generate the session secret of the self-service portal into
# state/passwords.env (mode 0600): secrets must not be stored in
# state/environment, which NS8 mirrors to Redis in plain text. The LDAP bind
# password is written to the same file by configure-module.

import secrets

import modsecrets

modsecrets.ensure({"SESSION_SECRET": secrets.token_hex(32)})
