# Return the global options and the device registry, each device enriched with
# live state: whether its pairing record is present in the container and how
# many backups it has.

import json
import os
import subprocess
import sys

env = os.environ
CONTAINER = "idevice-backup"

running = False
try:
    st = subprocess.run(["podman", "inspect", CONTAINER, "--format", "{{.State.Status}}"],
                        capture_output=True, text=True, timeout=10).stdout.strip()
    running = st == "running"
except Exception:
    pass

try:
    with open("devices.json") as fp:
        registry = json.load(fp)
except FileNotFoundError:
    registry = {}

# Live enrichment: one shell call lists the lockdown records and the backup dirs.
present = set()
counts = {}
if running:
    try:
        out = subprocess.run(["podman", "exec", CONTAINER, "sh", "-c",
                              "ls /var/lib/lockdown/ 2>/dev/null | sed 's/\\.plist$//'; echo '@@'; "
                              "for d in /data/backups/*/; do [ -d \"$d\" ] && echo \"$(basename $d) $(ls -1 \"$d\" 2>/dev/null | wc -l)\"; done"],
                             capture_output=True, text=True, timeout=15).stdout
        head, _, tail = out.partition("@@")
        present = {l.strip() for l in head.splitlines() if l.strip()}
        for line in tail.splitlines():
            parts = line.split()
            if len(parts) == 2 and parts[1].isdigit():
                counts[parts[0]] = int(parts[1])
    except Exception:
        pass

devices = []
for udid, d in sorted(registry.items(), key=lambda kv: kv[1].get("name", "")):
    devices.append({
        "udid": udid,
        "name": d.get("name", udid),
        "ip": d.get("ip", ""),
        "paired_at": d.get("paired_at", 0),
        "pairing_present": udid in present,
        "last_backup": d.get("last_backup", 0),
        "last_status": d.get("last_status", ""),
        "backup_count": counts.get(udid, 0),
        "encryption": bool(d.get("encryption", False)),
        "encryption_password_set": bool(d.get("encryption_password")),
        "backup_mode": d.get("backup_mode", "full"),
        "last_error": d.get("last_error", ""),
        "owner": d.get("owner", ""),
        "domain": d.get("domain", ""),
    })

config = {
    "retention": int(env.get("RETENTION", "3")),
    "include_backups": env.get("IDEVICE_INCLUDE_BACKUPS", "false").strip().lower() in ("1", "true", "yes", "on"),
    "container_running": running,
    "devices": devices,
}
json.dump(config, fp=sys.stdout)
