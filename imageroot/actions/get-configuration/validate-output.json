{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/idevice-backup/get-configuration-output.json",
    "type": "object",
    "properties": {
        "retention": {
            "type": "integer"
        },
        "container_running": {
            "type": "boolean"
        },
        "devices": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "udid": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "ip": {
                        "type": "string"
                    },
                    "paired_at": {
                        "type": "integer"
                    },
                    "pairing_present": {
                        "type": "boolean"
                    },
                    "last_backup": {
                        "type": "integer"
                    },
                    "last_status": {
                        "type": "string"
                    },
                    "backup_count": {
                        "type": "integer"
                    },
                    "encryption": {
                        "type": "boolean"
                    },
                    "encryption_password_set": {
                        "type": "boolean"
                    },
                    "backup_mode": {
                        "type": "string"
                    },
                    "last_error": {
                        "type": "string"
                    },
                    "owner": {
                        "type": "string"
                    },
                    "domain": {
                        "type": "string"
                    },
                    "incomplete_count": {
                        "type": "integer",
                        "title": "Unfinished snapshots, kept to be continued; they do not count as backups"
                    },
                    "running": {
                        "type": "boolean",
                        "title": "A backup or restore of this device is running, whoever started it"
                    },
                    "run_state": {
                        "type": "string",
                        "enum": [
                            "idle",
                            "running",
                            "waiting",
                            "restoring"
                        ],
                        "title": "waiting = pause before the next attempt after a lost connection"
                    },
                    "progress": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100,
                        "title": "Percentage reported by the device for the running backup"
                    },
                    "attempt": {
                        "type": "integer"
                    },
                    "attempts": {
                        "type": "integer"
                    }
                }
            }
        },
        "include_backups": {
            "type": "boolean"
        },
        "selfservice_host": {
            "type": "string"
        },
        "selfservice_url": {
            "type": "string"
        },
        "web_running": {
            "type": "boolean"
        },
        "ldap_enabled": {
            "type": "boolean"
        },
        "ldap_url": {
            "type": "string"
        },
        "ldap_base_dn": {
            "type": "string"
        },
        "ldap_bind_dn": {
            "type": "string"
        },
        "ldap_user_attribute": {
            "type": "string"
        },
        "ldap_group": {
            "type": "string"
        },
        "ldap_bind_password_set": {
            "type": "boolean"
        },
        "selfservice_restore": {
            "type": "boolean"
        },
        "ldap_domain": {
            "type": "string"
        },
        "selfservice_path": {
            "type": "string"
        }
    }
}
