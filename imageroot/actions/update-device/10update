# Update a device's display name and/or WiFi IP address in the registry
# (e.g. after a DHCP lease change), without re-uploading the pairing file.

import json
import re
import sys

import agent
import devreg

UDID_RE = re.compile(r"^[A-Za-z0-9-]{16,45}$")

data = json.load(sys.stdin)
udid = str(data["udid"]).strip()
if not UDID_RE.match(udid):
    print(agent.SD_ERR + "invalid UDID", file=sys.stderr)
    sys.exit(2)

with devreg.locked():
    devices = devreg.load_devices()
    if udid not in devices:
        print(agent.SD_ERR + "unknown device", file=sys.stderr)
        sys.exit(2)
    if "name" in data and (data["name"] or "").strip():
        devices[udid]["name"] = data["name"].strip()
    if "ip" in data:
        devices[udid]["ip"] = (data["ip"] or "").strip()
    if "backup_mode" in data:
        m = (data["backup_mode"] or "full").strip().lower()
        devices[udid]["backup_mode"] = "incremental" if m == "incremental" else "full"
    if "owner" in data:
        owner = (data["owner"] or "").strip()
        if owner:
            devices[udid]["owner"] = owner
        else:
            devices[udid].pop("owner", None)
            devices[udid].pop("domain", None)
    if "domain" in data:
        dom = (data["domain"] or "").strip()
        if dom:
            devices[udid]["domain"] = dom
        else:
            devices[udid].pop("domain", None)
    if "encryption_password" in data:
        # state/device-secrets.json (0600), never the registry; empty = forget it
        devreg.set_password(udid, str(data["encryption_password"] or ""))
    devreg.save_devices(devices)
json.dump({"udid": udid, "name": devices[udid]["name"], "ip": devices[udid]["ip"],
           "backup_mode": devices[udid].get("backup_mode", "full"),
           "owner": devices[udid].get("owner", "")}, fp=sys.stdout)
