{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "update-device input",
    "$id": "http://nethserver.org/json-schema/task/input/idevice-backup/update-device",
    "type": "object",
    "required": [
        "udid"
    ],
    "properties": {
        "udid": {
            "type": "string",
            "maxLength": 45
        },
        "name": {
            "type": "string",
            "maxLength": 100
        },
        "ip": {
            "type": "string",
            "maxLength": 253
        },
        "backup_mode": {
            "type": "string",
            "title": "Backup mode",
            "enum": [
                "full",
                "incremental"
            ]
        },
        "encryption_password": {
            "type": "string",
            "title": "Backup encryption password",
            "maxLength": 200
        },
        "owner": {
            "type": "string",
            "title": "Owner (LDAP user id or user@domain)",
            "maxLength": 255
        },
        "domain": {
            "type": "string",
            "title": "Owner user domain",
            "maxLength": 255
        }
    }
}
