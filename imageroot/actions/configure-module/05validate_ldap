# Directory login of the self-service portal: check the settings when the
# request changes them (see pypkg/ldapsettings.py).

import json
import os
import sys

import agent
import ldapsettings

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)
if not any(k.startswith("ldap_") and k != "ldap_enabled" for k in data):
    sys.exit(0)
host = data.get("selfservice_host", os.environ.get("SELFSERVICE_HOST", ""))
enabled = data.get("ldap_enabled", os.environ.get("LDAP_ENABLED", "false") == "true")
if "ldap_source" not in data and not os.environ.get("LDAP_SOURCE"):
    data["ldap_source"] = "custom"  # a client of an earlier version
errors = [{"field": f, "parameter": f, "value": data.get(f, "") if f != "ldap_bind_password" else "", "error": e}
          for f, e in ldapsettings.validate(data, active=bool(host) and bool(enabled))]
if errors:
    agent.set_status("validation-failed")
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
