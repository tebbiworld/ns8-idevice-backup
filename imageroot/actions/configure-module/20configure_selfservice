# Configure the self-service web app: LDAP settings (entered by the admin, the
# ARSnova pattern — direct bind, no user-domain join needed), a Traefik route
# under the self-service host name, and the web unit. Writes ldap.env / web.env
# that the web container reads.

import json
import os
import subprocess
import sys
import urllib.parse

import agent
import agent.tasks

data = json.load(sys.stdin)
env = os.environ
module_id = env["MODULE_ID"]

host = (data.get("selfservice_host") or "").strip().lower()
path = (data.get("selfservice_path") or "").strip()
if path and not path.startswith("/"):
    path = "/" + path
path = path.rstrip("/")
h2hs = bool(data.get("http2https", True))
lets_encrypt = bool(data.get("lets_encrypt", False))

ldap_enabled = bool(data.get("ldap_enabled", False))
ldap_url = (data.get("ldap_url") or "").strip().rstrip("/")
ldap_base_dn = (data.get("ldap_base_dn") or "").strip()
ldap_bind_dn = (data.get("ldap_bind_dn") or "").strip()
ldap_bind_password = data.get("ldap_bind_password")
ldap_user_attribute = (data.get("ldap_user_attribute") or "sAMAccountName").strip() or "sAMAccountName"
ldap_group = (data.get("ldap_group") or "").strip()

# keep the stored password when the field is left empty on a reconfigure
if ldap_bind_password is None or ldap_bind_password == "":
    ldap_bind_password = env.get("LDAP_BIND_PASSWORD", "")

ldap_host, ldap_port, scheme = "", "636", "ldaps"
if ldap_url:
    parts = urllib.parse.urlsplit(ldap_url)
    scheme = parts.scheme or "ldaps"
    ldap_host = parts.hostname or ""
    ldap_port = str(parts.port or (389 if scheme == "ldap" else 636))

agent.mset_env({
    "SELFSERVICE_HOST": host,
    "SELFSERVICE_PATH": path,
    "TRAEFIK_HTTP2HTTPS": "True" if h2hs else "False",
    "LDAP_ENABLED": "true" if ldap_enabled else "false",
    "LDAP_URL": ldap_url,
    "LDAP_HOST": ldap_host,
    "LDAP_PORT": ldap_port,
    "LDAP_BASE_DN": ldap_base_dn,
    "LDAP_BIND_DN": ldap_bind_dn,
    "LDAP_BIND_PASSWORD": ldap_bind_password,
    "LDAP_USER_ATTRIBUTE": ldap_user_attribute,
    "LDAP_GROUP": ldap_group,
})

# The container may have to reach the directory via host.containers.internal
# under pasta (only relevant if the DC is on this node); external AD is left as
# is. Reuse the shared helper.
container_host = ldap_host
container_url = ldap_url
if ldap_host:
    try:
        container_host = subprocess.run(["ldap-container-host", ldap_host],
                                        capture_output=True, text=True, check=True).stdout.strip() or ldap_host
    except Exception:
        container_host = ldap_host
    if container_host != ldap_host and ldap_url:
        container_url = f"{scheme}://{container_host}:{ldap_port}"


def write_envfile(path, kv):
    tmp = path + ".tmp"
    with open(tmp, "w") as fp:
        fp.write("# Generated by configure-module. Do not edit by hand.\n")
        for k, v in kv.items():
            fp.write(f"{k}={v}\n")
    os.replace(tmp, path)


write_envfile("ldap.env", {
    "LDAP_URL": ldap_url,
    "LDAP_URL_CONTAINER": container_url,
    "LDAP_HOST": ldap_host,
    "LDAP_HOST_CONTAINER": container_host,
    "LDAP_PORT": ldap_port,
    "LDAP_BASE_DN": ldap_base_dn,
    "LDAP_BIND_DN": ldap_bind_dn,
    "LDAP_BIND_PASSWORD": ldap_bind_password,
    "LDAP_USER_ATTRIBUTE": ldap_user_attribute,
    "LDAP_GROUP": ldap_group,
})
selfservice_restore = bool(data.get("selfservice_restore", True))
agent.set_env("SELFSERVICE_RESTORE", "true" if selfservice_restore else "false")
ldap_domain = (data.get("ldap_domain") or "").strip()
agent.set_env("LDAP_DOMAIN", ldap_domain)
write_envfile("web.env", {
    "SESSION_SECRET": env.get("SESSION_SECRET", ""),
    "APP_TITLE": "iOS Device Backup",
    "WEB_INTERNAL_PORT": "8080",
    "STATE_DIR": "/state",
    "LDAP_DOMAIN": ldap_domain,
    "SELFSERVICE_RESTORE": "true" if selfservice_restore else "false",
})

# Traefik route for the self-service host
route_marker = ".selfservice-route"
if host:
    route = {
        "instance": module_id + "-web",
        "url": "http://127.0.0.1:" + str(env["WEB_PORT"]),
        "host": host,
        "http2https": h2hs,
        "lets_encrypt_check": True,
        "lets_encrypt_cleanup": True,
    }
    if path:
        route["path"] = path
        route["strip_prefix"] = True
        route["slash_redirect"] = True
    if "lets_encrypt" in data:
        route["lets_encrypt"] = lets_encrypt
    agent.set_route(route)
    open(route_marker, "w").close()
elif os.path.exists(route_marker):
    tid = agent.resolve_agent_id("traefik@node")
    if tid is not None:
        agent.tasks.run(agent_id=tid, action="delete-route", data={"instance": module_id + "-web"})
    os.remove(route_marker)

# Start or stop the web unit: only run it when a host and LDAP are configured.
want_web = bool(host and ldap_enabled and ldap_url and ldap_base_dn and ldap_bind_dn)
if want_web:
    subprocess.run(["systemctl", "--user", "enable", "idevice-web.service"], check=True)
    subprocess.run(["systemctl", "--user", "restart", "idevice-web.service"], check=True)
else:
    subprocess.run(["systemctl", "--user", "disable", "--now", "idevice-web.service"], check=False)
