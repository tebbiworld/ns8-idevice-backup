# Remove a device: its pairing record, its registry entry, and — if asked — its
# stored backups.

import json
import re
import subprocess
import sys

import agent
import devreg

CONTAINER = "idevice-backup"
UDID_RE = re.compile(r"^[A-Za-z0-9-]{16,45}$")

data = json.load(sys.stdin)
udid = str(data["udid"]).strip()
if not UDID_RE.match(udid):
    print(agent.SD_ERR + "invalid UDID", file=sys.stderr)
    sys.exit(2)
delete_backups = bool(data.get("delete_backups", False))

paths = [f"/var/lib/lockdown/{udid}.plist"]
if delete_backups:
    paths.append(f"/data/backups/{udid}")
subprocess.run(["podman", "exec", CONTAINER, "sh", "-c", "rm -rf " + " ".join(f"'{p}'" for p in paths)],
               capture_output=True)

with devreg.locked():
    devices = devreg.load_devices()
    devices.pop(udid, None)
    devreg.save_devices(devices)
    devreg.forget(udid)

json.dump({"udid": udid, "deleted_backups": delete_backups}, fp=sys.stdout)
