# List the stored backup snapshots of one device (directories under
# /data/backups/<udid>), newest first, with their size. "complete" is false for
# a backup the device has not finished: it is kept to be continued, it cannot
# be restored and it does not count towards the retention.

import json
import re
import subprocess
import sys

import agent

CONTAINER = "idevice-backup"
UDID_RE = re.compile(r"^[A-Za-z0-9-]{16,45}$")

data = json.load(sys.stdin)
udid = str(data["udid"]).strip()
if not UDID_RE.match(udid):
    print(agent.SD_ERR + "invalid UDID", file=sys.stderr)
    sys.exit(2)

backups = []
try:
    out = subprocess.run(["podman", "exec", CONTAINER, "sh", "-c",
                          f"for d in /data/backups/{udid}/*/; do [ -d \"$d\" ] && echo \"$(basename $d)|$(du -sm \"$d\" 2>/dev/null | cut -f1)\"; done"],
                         capture_output=True, text=True, timeout=30).stdout
    for line in out.splitlines():
        name, _, size = line.partition("|")
        if name.strip():
            backups.append({"snapshot": name.strip(), "size_mb": int(size) if size.strip().isdigit() else 0})
except Exception:
    pass
try:
    out = subprocess.run(["podman", "exec", CONTAINER, "idevice-tool", "snapshots", "--udid", udid,
                          "--base", f"/data/backups/{udid}"], capture_output=True, text=True, timeout=30).stdout
    complete = {x["snapshot"]: bool(x["complete"]) for x in json.loads(out.strip().splitlines()[-1])["snapshots"]}
except Exception:
    complete = {}
for b in backups:
    b["complete"] = complete.get(b["snapshot"], True)
backups.sort(key=lambda b: b["snapshot"], reverse=True)
json.dump({"udid": udid, "backups": backups}, fp=sys.stdout)
