# Run a backup of one device: connect by its IP through the engine container
# (idevice-tool, pymobiledevice3). The tool picks the snapshot (a new time
# stamp, the unfinished one to continue, or the incremental directory), retries
# when the connection drops, reports the percentage and prunes finished
# snapshots beyond the retention count.

import json
import os
import re
import subprocess
import sys
import time

import agent
import devreg

CONTAINER = "idevice-backup"
UDID_RE = re.compile(r"^[A-Za-z0-9-]{16,45}$")

data = json.load(sys.stdin)
udid = str(data["udid"]).strip()
if not UDID_RE.match(udid):
    print(agent.SD_ERR + "invalid UDID", file=sys.stderr)
    sys.exit(2)

dev = devreg.load_devices().get(udid)
if not dev:
    print(agent.SD_ERR + "unknown device", file=sys.stderr)
    sys.exit(2)
ip = (dev.get("ip") or "").strip()
if not ip:
    print(agent.SD_ERR + "set the device WiFi IP address first", file=sys.stderr)
    sys.exit(2)

retention = int(os.environ.get("RETENTION", "3"))
mode = "incremental" if (dev.get("backup_mode") or "full").strip().lower() == "incremental" else "full"
name = dev.get("name", udid)

cmd = ["podman", "exec"]
env = os.environ.copy()
enc_pw = devreg.get_password(udid)
if enc_pw:
    # value-less --env: podman takes it from our environment, so the password
    # never shows up in a process list. The engine skips it if the device is
    # already encrypted.
    env["IDEVICE_SET_PASSWORD"] = enc_pw
    cmd += ["--env", "IDEVICE_SET_PASSWORD"]
cmd += [CONTAINER, "idevice-tool", "backup", "--udid", udid, "--ip", ip,
        "--base", f"/data/backups/{udid}", "--mode", mode,
        "--retention", str(retention), "--progress-events"]
if enc_pw:
    cmd += ["--set-password"]

print(agent.SD_INFO + f"starting {mode} backup of {name} at {ip}", file=sys.stderr)
proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
result = {}
noise = []
for line in proc.stdout:
    line = line.strip()
    if not line.startswith("{"):
        if line:
            noise = (noise + [line])[-10:]
        continue
    try:
        msg = json.loads(line)
    except ValueError:
        continue
    event = msg.get("event")
    if event == "progress":
        agent.set_progress(min(99, int(msg.get("percent") or 0)))
    elif event == "attempt":
        how = "continuing" if msg.get("resumed") else "starting"
        print(agent.SD_INFO + f"{name}: attempt {msg.get('attempt')}/{msg.get('attempts')}, {how} snapshot {msg.get('snapshot')}", file=sys.stderr)
    elif event == "retry":
        print(agent.SD_WARNING + f"{name}: attempt {msg.get('attempt')}/{msg.get('attempts')} lost the connection "
              f"({msg.get('type')}: {msg.get('error')}); next attempt in {int(msg.get('wait') or 0)} s", file=sys.stderr)
    elif "ok" in msg:
        result = msg
proc.wait()

now = int(time.time())
ok = proc.returncode == 0 and result.get("ok") is True
if ok:
    err = ""
else:
    etype = result.get("type") or ""
    err = result.get("error") or etype or " | ".join(noise)[-500:] or "backup failed"
    if etype == "ConnectionTerminatedError" and "attempt" not in err:
        err = ("the device closed the connection (ConnectionTerminatedError). Unlock the iPhone, keep it "
               "awake and enter the passcode when it asks for it, then start the backup again.")

with devreg.locked():
    devices = devreg.load_devices()
    dev = devices.get(udid)
    if dev is not None:
        if ok:
            if "device_encrypted" in result:
                dev["encryption"] = bool(result["device_encrypted"])
            elif result.get("encryption_enabled"):
                dev["encryption"] = True
            dev["last_backup"] = now
            dev["last_status"] = "ok"
            dev["last_error"] = ""
        else:
            dev["last_status"] = "failed"
            dev["last_error"] = err[:500]
        devreg.save_devices(devices)

if not ok:
    print(agent.SD_ERR + "backup failed: " + err, file=sys.stderr)
    sys.exit(1)

json.dump({"udid": udid, "snapshot": result.get("snapshot", ""), "status": "ok",
           "resumed": bool(result.get("resumed")), "attempts": int(result.get("attempts_used") or 1)}, fp=sys.stdout)
