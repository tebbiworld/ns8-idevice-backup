# Restore one stored snapshot back ONTO a device. DESTRUCTIVE: it overwrites the
# iPhone/iPad with the backup and reboots it. Connects by the device IP through
# the engine container (idevice-tool restore); an encrypted backup uses the
# stored (or supplied) encryption password.

import json
import os
import re
import subprocess
import sys

import agent
import devreg

CONTAINER = "idevice-backup"
UDID_RE = re.compile(r"^[A-Za-z0-9-]{16,45}$")
SNAP_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,64}$")


data = json.load(sys.stdin)
udid = str(data["udid"]).strip()            # the snapshot's original device (source)
snapshot = str(data.get("snapshot") or "").strip()
target_udid = str(data.get("target_udid") or udid).strip()  # device to restore ONTO
if not UDID_RE.match(udid) or not UDID_RE.match(target_udid):
    print(agent.SD_ERR + "invalid UDID", file=sys.stderr)
    sys.exit(2)
if not SNAP_RE.match(snapshot):
    print(agent.SD_ERR + "invalid or missing snapshot name", file=sys.stderr)
    sys.exit(2)

devices = devreg.load_devices()
dev = devices.get(udid)          # source device (owns the backup + its password)
target = devices.get(target_udid)  # device we connect to and write onto
if not dev:
    print(agent.SD_ERR + "unknown source device", file=sys.stderr)
    sys.exit(2)
if not target:
    print(agent.SD_ERR + "unknown target device (pair it first)", file=sys.stderr)
    sys.exit(2)
ip = (target.get("ip") or "").strip()
if not ip:
    print(agent.SD_ERR + "set the target device WiFi IP address first", file=sys.stderr)
    sys.exit(2)
cross_device = target_udid != udid

dest = f"/data/backups/{udid}/{snapshot}"
# the snapshot must exist, hold the <udid> backup folder and be a finished backup
check = subprocess.run(["podman", "exec", CONTAINER, "idevice-tool", "snapshots", "--udid", udid,
                        "--base", f"/data/backups/{udid}"], capture_output=True, text=True)
try:
    known = {s["snapshot"]: s["complete"] for s in json.loads(check.stdout.strip().splitlines()[-1])["snapshots"]}
except Exception:
    known = {}
if snapshot not in known:
    print(agent.SD_ERR + f"snapshot '{snapshot}' not found for this device", file=sys.stderr)
    sys.exit(2)
if not known[snapshot]:
    print(agent.SD_ERR + f"snapshot '{snapshot}' is an unfinished backup and cannot be restored", file=sys.stderr)
    sys.exit(2)

enc_pw = (data.get("encryption_password") or devreg.get_password(udid) or "")

cmd = ["podman", "exec"]
env = os.environ.copy()
if enc_pw:
    # value-less --env: the password is handed over through our environment,
    # not on the command line
    env["IDEVICE_RESTORE_PASSWORD"] = enc_pw
    cmd += ["--env", "IDEVICE_RESTORE_PASSWORD"]
cmd += [CONTAINER, "idevice-tool", "restore", "--udid", target_udid, "--ip", ip,
        "--dir", dest, "--source", udid]

tgt_name = target.get("name", target_udid)
if cross_device:
    print(agent.SD_INFO + f"restoring the backup of {dev.get('name', udid)} ({snapshot}) ONTO {tgt_name} "
          f"(that device is overwritten and reboots)", file=sys.stderr)
else:
    print(agent.SD_INFO + f"restoring {tgt_name} from {snapshot} (the device is overwritten and reboots)", file=sys.stderr)
proc = subprocess.run(cmd, capture_output=True, text=True, env=env)
out = (proc.stdout or "").strip().splitlines()
result = {}
for line in reversed(out):
    line = line.strip()
    if line.startswith("{"):
        try:
            result = json.loads(line)
            break
        except Exception:
            pass

if proc.returncode != 0 or not result.get("ok"):
    etype = result.get("type") or ""
    err = result.get("error") or etype or (proc.stderr or "").strip()[-500:] or "restore failed"
    if etype in ("TimeoutError", "ConnectionRefusedError", "OSError", "ConnectionError"):
        err = (f"could not reach the device at {ip}:62078 ({etype}). Check the IP address, "
               f"that WiFi lockdown is enabled on the device, and that the server can route to it.")
    elif etype == "ConnectionTerminatedError":
        err = ("the device closed the connection (ConnectionTerminatedError). Unlock the iPhone, keep it "
               "awake and confirm the restore prompt on the device, then try again.")
    print(agent.SD_ERR + "restore failed: " + err, file=sys.stderr)
    sys.exit(1)

json.dump({"udid": udid, "target_udid": target_udid, "snapshot": snapshot, "status": "ok"}, fp=sys.stdout)
